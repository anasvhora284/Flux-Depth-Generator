# Backend Environment Variables
# Copy this file to .env and fill in the values

# ===================
# REQUIRED FOR PRODUCTION
# ===================

# Database - PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost/flux_depth_db

# Security - Generate a strong secret key
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-here

# Email Configuration (Gmail SMTP example)
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Flux Depth Generator

# ===================
# OPTIONAL
# ===================

# CORS Origins (comma-separated list of allowed frontend URLs)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Token expiration (in minutes, default: 1440 = 24 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
